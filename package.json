{
  "name": "laxdb",
  "description": "Lax DB is a suite of tools made with lacrosse in mind",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "dev": "infisical run --env=dev -- alchemy dev",
    "test": "bun ./scripts/run-workspace-tests.mjs",
    "test:integration": "bun ./scripts/run-workspace-integration-tests.mjs",
    "test:ci": "bash ./scripts/run-ci-tests.sh",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "design:lint": "bunx @google/design.md@0.4.0 lint DESIGN.md",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:fix": "turbo format:fix",
    "fix": "bun run lint:fix && bun run format:fix",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/tsgo": "0.31.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@tanstack/react-table": "^8.21.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "lefthook": "^2.1.12",
    "miniflare": "^4.20260116.0",
    "oxfmt": "^0.24.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "rolldown": "1.2.5",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "libsodium-wrappers": "0.7.13"
  },
  "packageManager": "bun@1.3.14"
}
