{
  "name": "@laxdb/malvern",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 1438 --strictPort",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "bun --bun vitest run --configLoader=runner",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix --quiet",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "fix": "bun run lint:fix && bun run format:fix"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-beta.103",
    "@laxdb/api": "workspace:*",
    "@laxdb/core": "workspace:*",
    "@laxdb/frontend": "workspace:*",
    "@laxdb/reactivity": "workspace:*",
    "@laxdb/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "^1.143.11",
    "@tanstack/react-start": "^1.143.12",
    "better-auth": "^1.6.5",
    "effect": "4.0.0-beta.103",
    "lucide-react": "^0.475.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "scheduler": "^0.27.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.1.18",
    "vite": "^8.2.0"
  }
}
